# jmdn-health-collector environment — managed by jmdn-validator-runbook.
JMDN_EXPLORER_PORT={{ jmdn_endpoints.explorer_port | default(8090) }}
JMDN_FACADE_PORT={{ jmdn_endpoints.facade_port | default(8545) }}
JMDN_TEXTFILE_DIR={{ jmdn_health_textfile_dir }}
# Group node_exporter reads as; the collector chgrps its output to this.
JMDN_TEXTFILE_GROUP={{ node_exporter_group | default('node_exporter') }}
JMDN_STATE_DIR={{ jmdn_health_state_dir }}
JMDN_CURL_TIMEOUT={{ jmdn_health_curl_timeout | default(2) }}
{% if explorer_api_key is defined and explorer_api_key | length > 0 %}
JMDN_EXPLORER_API_KEY={{ explorer_api_key }}
{% endif %}
