# Managed by jmdn-validator-runbook. Local edits will be overwritten.
#
# A DROP-IN, not a replacement for /etc/systemd/journald.conf. This machine is
# yours: overwriting the distro's file would discard anything you or your distro
# set there, and would be silently reverted by a package upgrade. A drop-in
# layers on top and only states what we change.
#
# SCOPE: this file sets ONLY directives that no other component on a JMDN node
# sets. jmdn's own Scripts/install_services.sh writes
# /etc/systemd/journald.conf.d/jmdn-limits.conf (SystemMaxUse, MaxRetentionSec),
# and that filename sorts AFTER this one, so anything we wrote for those keys
# would be silently overridden. Total journal size is jmdn's to own; the rate
# limit is ours, and it is the directive that actually loses data.
# See docs/DESIGN.md D-18.
#
# Remove this file and `systemctl restart systemd-journald` to revert entirely.
[Journal]
# Explicit rather than relying on /var/log/journal existing, which is what
# Storage=auto keys off. Without it a missing directory silently downgrades the
# journal to RAM-only and every log is lost on reboot.
Storage=persistent

# --- Size ---------------------------------------------------------------------
# SystemMaxUse is deliberately absent: jmdn-limits.conf owns it.
#
# SystemKeepFree is deliberately absent: journald's parser rejects a percentage
# here — "Failed to parse SystemKeepFree=15%, ignoring: Invalid argument" —
# observed on Ubuntu 26.04. The man page states the DEFAULT as 15% of the
# filesystem, which is the behaviour we wanted, so the correct action is to not
# set it rather than to hard-code an absolute size that cannot scale.
SystemMaxFileSize={{ journald_max_file_size }}
RuntimeMaxUse={{ journald_runtime_max_use }}

# --- Rate limiting ------------------------------------------------------------
# Beyond this, journald DISCARDS messages. Raised well above the 10000/30s
# default so a block-processing burst does not silently truncate the logs you
# would need to explain it. Nothing else on a JMDN node sets these.
RateLimitIntervalSec={{ journald_rate_limit_interval }}
RateLimitBurst={{ journald_rate_limit_burst }}

# Don't broadcast emergency messages to every terminal.
ForwardToWall=no
