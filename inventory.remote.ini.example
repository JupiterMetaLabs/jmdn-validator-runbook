# Optional: manage several of your own nodes from one machine.
# Copy to inventory.remote.ini, then pass -i inventory.remote.ini.
#
# node_id must be unique per host — it becomes the `server` label on every
# metric, and two hosts sharing it will silently merge in our dashboards.
[operator_node]
validator-1 ansible_host=10.0.0.11 ansible_user=ubuntu node_id=acme-validator-1
validator-2 ansible_host=10.0.0.12 ansible_user=ubuntu node_id=acme-validator-2

[operator_node:vars]
ansible_ssh_private_key_file=~/.ssh/id_ed25519
